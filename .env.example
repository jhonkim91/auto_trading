# ============================================================
#  한국투자증권 자동매매 프로그램 환경설정 예시
#  이 파일을 복사해 ".env" 로 저장한 뒤 값을 채우세요.
#  .env 파일은 절대 git 등에 올리지 마세요 (.gitignore 에 포함됨)
# ============================================================

# ---- 거래 모드: paper(모의) 또는 real(실전) ----
# 처음에는 반드시 paper 로 시작하세요.
TRADING_MODE=paper

# ---- KIS Developers 앱키/시크릿 ----
# 모의투자 계좌용 앱키 (https://apiportal.koreainvestment.com 에서 발급)
KIS_PAPER_APP_KEY=여기에_모의투자_APP_KEY
KIS_PAPER_APP_SECRET=여기에_모의투자_APP_SECRET
KIS_PAPER_ACCOUNT=00000000-01    # 모의 계좌번호-상품코드 (예: 50000000-01)

# 실전투자 계좌용 앱키 (실전 전환 시에만 채우세요)
KIS_REAL_APP_KEY=여기에_실전_APP_KEY
KIS_REAL_APP_SECRET=여기에_실전_APP_SECRET
KIS_REAL_ACCOUNT=00000000-01     # 실전 계좌번호-상품코드

# ---- 텔레그램 봇 ----
# BotFather 에서 /newbot 으로 발급한 토큰
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰
# 본인 chat_id (여러 명이면 쉼표로 구분). @userinfobot 또는 getUpdates 로 확인
TELEGRAM_ALLOWED_CHAT_IDS=123456789
